<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alkoholkalkylator</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f2f4f7;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    .app {
      background: white;
      width: 100%;
      max-width: 420px;
      padding: 28px;
      border-radius: 22px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.10);
    }

    h1 {
      margin-top: 0;
      text-align: center;
      font-size: 28px;
    }

    .subtitle {
      text-align: center;
      color: #666;
      margin-bottom: 28px;
    }

    label {
      display: block;
      font-weight: 600;
      margin-top: 18px;
      margin-bottom: 7px;
    }

    input {
      width: 100%;
      padding: 15px;
      font-size: 20px;
      border: 1px solid #ccc;
      border-radius: 12px;
      outline: none;
    }

    input:focus {
      border-color: #555;
    }

    .resultat {
      margin-top: 28px;
      padding: 22px;
      background: #f0f6ff;
      border-radius: 16px;
      text-align: center;
    }

    .resultat-text {
      font-size: 16px;
      color: #555;
      margin-bottom: 6px;
    }

    #resultat {
      font-size: 34px;
      font-weight: 700;
    }
  </style>
</head>

<body>

  <div class="app">
    <h1>Alkoholkalkylator</h1>

    <div class="subtitle">
      Beräkna mängden ren alkohol
    </div>

    <label for="mangd">Mängd dryck (ml)</label>
    <input
      type="text"
      inputmode="decimal"
      id="mangd"
      placeholder="t.ex. 500"
    >

    <label for="procent">Alkoholhalt (%)</label>
    <input
      type="text"
      inputmode="decimal"
      id="procent"
      placeholder="t.ex. 5,2"
    >

    <div class="resultat">
      <div class="resultat-text">Ren alkohol</div>
      <div id="resultat">0 ml</div>
    </div>
  </div>

  <script>
    const mangd = document.getElementById("mangd");
    const procent = document.getElementById("procent");
    const resultat = document.getElementById("resultat");

    function hamtaTal(varde) {
      return parseFloat(varde.replace(",", "."));
    }

    function berakna() {
      const ml = hamtaTal(mangd.value);
      const alkoholhalt = hamtaTal(procent.value);

      if (isNaN(ml) || isNaN(alkoholhalt)) {
        resultat.textContent = "0 ml";
        return;
      }

      const alkohol = ml * alkoholhalt / 100;

      resultat.textContent =
        alkohol.toLocaleString("sv-SE", {
          maximumFractionDigits: 2
        }) + " ml";
    }

    mangd.addEventListener("input", berakna);
    procent.addEventListener("input", berakna);
  </script>

</body>
</html>
